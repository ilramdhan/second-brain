# Second Brain – environment variables
# Copy to .env (git-ignored) and fill in the values:  cp .env.example .env
# Set the same variables in your hosting provider (e.g. Vercel → Settings → Environment Variables).
# NEVER commit real values. VITE_* variables are inlined into the client bundle at
# build time and are therefore PUBLIC; everything else must stay server-side.

# ---------------------------------------------------------------------------
# Supabase – browser client (required, public, build-time)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key (safe to expose; access is enforced by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase – server (required)
# ---------------------------------------------------------------------------
# Used for SSR, the auth middleware and the admin client
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key used by requireSupabaseAuth to build a per-user (RLS) client
SUPABASE_PUBLISHABLE_KEY=
# SECRET – bypasses RLS. Used only server-side (Telegram webhook, reminders,
# unblock notifications, encrypted connection store). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Nitro deploy preset for `vite build`. Default: vercel (writes .vercel/output).
# Other examples: node-server (self-hosting, run .output/server/index.mjs), cloudflare-module.
# NITRO_PRESET=vercel
# Security headers are added to SSR/API responses in production; set to "off" only when the
# host already sends its own policy.
# SECURITY_HEADERS=on
# Public base URL of the app (no trailing slash). Used for the Google OAuth redirect URI.
# APP_URL=https://2ndbrain.ilramdhan.dev
# Optional, public, build-time: URL of the public demo deployment (Phase 10). When set, the
# landing page shows a "Coba Demo" button (hero, header, mobile menu) that opens the demo's own
# landing page (its root, not /login) in the same tab; when empty the button is hidden.
# VITE_DEMO_URL=https://demo-2ndbrain.ilramdhan.dev
# Optional, public, build-time: "true" shows the sign-up option on /login. Default (unset):
# sign-up hidden. The UI alone does not close registration, because auth.signUp can be called
# with the public anon key: also turn off Supabase → Authentication → Sign In / Providers →
# "Allow new users to sign up", and create accounts via Authentication → Users → Invite/Add user.
# VITE_ALLOW_SIGNUP=false

# ---------------------------------------------------------------------------
# Demo mode (Phase 10) – only on the separate public demo deployment
# ---------------------------------------------------------------------------
# Set BOTH to "demo" on the demo project and leave both unset everywhere else (the server warns
# once when they disagree). APP_MODE turns on the server guards: Telegram, Google Calendar,
# outgoing webhooks and the n8n endpoints are refused, /_serverFn/* and /api/* are rate limited
# per IP, and every response carries X-Robots-Tag: noindex. AI is simulated: every AI feature
# answers from hard-coded fixtures (no provider call, AI_API_KEY not needed). VITE_APP_MODE
# switches the UI (banner, demo login, disabled controls, pre-filled AI examples, robots meta).
# APP_MODE=demo
# VITE_APP_MODE=demo
# Public demo account shown on /login (anyone may use it; not a secret). Defaults shown.
# VITE_DEMO_EMAIL=demo@ilramdhan.dev
# VITE_DEMO_PASSWORD=demo2ndbrain
# Account the daily reset (/api/public/n8n/demo/reset) creates if missing; defaults to the
# VITE_DEMO_* pair above, then demo@ilramdhan.dev / demo2ndbrain. An existing account's
# password is never changed by the reset (see docs/DEMO.md → Rotate the demo password).
# DEMO_EMAIL=demo@ilramdhan.dev
# DEMO_PASSWORD=demo2ndbrain
# The demo authenticates the reset with CRON_SECRET (Vercel Cron, registered automatically for
# builds with APP_MODE=demo) or N8N_API_KEY (optional n8n workflow 09). docs/DEMO.md has the
# full list of what to set and what NOT to set on the demo project.
# Production app linked from the demo banner.
# VITE_PROD_URL=https://2ndbrain.ilramdhan.dev
# Requests per minute per IP to /_serverFn/* and /api/* on the demo (in memory, per instance).
# DEMO_IP_RATE_LIMIT=120
# IANA time zone that defines "today" for digests, reminders and bot dates (servers run in UTC).
# APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# AI – capture, brain dump, summaries, OCR, voice (optional)
# ---------------------------------------------------------------------------
# Without AI_API_KEY the AI buttons show "AI belum dikonfigurasi"; everything else works.
# openai (default, OpenAI Responses API) | openai-compatible (any Chat Completions API)
AI_PROVIDER=openai
# SECRET – API key of the provider
AI_API_KEY=
# Base URL for openai-compatible providers (required there). Free-tier friendly examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1   (also offers whisper-large-v3 for voice)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
# AI_BASE_URL=
# Text model (default gpt-4o-mini). E.g. llama-3.3-70b-versatile (Groq), gemini-3.8-flash (Gemini)
# AI_MODEL=gpt-4o-mini
# Model for image input / OCR; defaults to AI_MODEL (must support vision)
# AI_VISION_MODEL=
# Voice capture mode: transcriptions (OpenAI-style /audio/transcriptions, default) | chat
# (Chat Completions with an input_audio part). Gemini has no /audio/transcriptions, so the mode
# defaults to chat when the transcription host is generativelanguage.googleapis.com.
# AI_TRANSCRIBE_MODE=transcriptions
# Speech-to-text model. Default whisper-1 (transcriptions) or AI_MODEL (chat);
# e.g. gpt-4o-mini-transcribe (OpenAI) or whisper-large-v3 (Groq)
# AI_TRANSCRIBE_MODEL=whisper-1
# Optional separate host for voice, e.g. Groq Whisper (free tier) while Gemini handles text:
#   AI_TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
#   AI_TRANSCRIBE_API_KEY=gsk_...          (SECRET; defaults to AI_API_KEY)
#   AI_TRANSCRIBE_MODEL=whisper-large-v3
# AI_TRANSCRIBE_BASE_URL=
# AI_TRANSCRIBE_API_KEY=
# Embedding model for semantic search (Cmd+K "Makna (AI)", POST {AI_BASE_URL}/embeddings).
# Default: gemini-embedding-001 when AI_BASE_URL is Gemini, otherwise text-embedding-3-small.
# Vectors are stored as 1536-d (longer ones, e.g. Gemini's 3072-d, are truncated and
# re-normalised). Changing the model makes every row stale: use Settings -> "Indeks ulang".
# AI_EMBEDDING_MODEL=
#
# Example – Google Gemini (AI Studio key) for everything incl. OCR and voice:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-3.8-flash
#   AI_VISION_MODEL=gemini-3.8-flash
#   AI_TRANSCRIBE_MODE=chat   (browser recordings: webm/ogg/mp4 are sent as-is; Gemini accepts them)
#   AI_EMBEDDING_MODEL=gemini-embedding-001   (the default on Gemini)

# ---------------------------------------------------------------------------
# Cron fallback – deadline reminders (optional; prefer n8n below)
# ---------------------------------------------------------------------------
# /api/public/hooks/reminders (GET or POST) requires `Authorization: Bearer <secret>`.
# Use it only when n8n does not run POST /api/public/n8n/reminders (never both).
# Accepted (constant-time compare): SECOND_BRAIN_CRON_SECRET, SECOND_BRAIN_CRON_SECRET_PREVIOUS
# (keep the old value here while rotating) and CRON_SECRET (Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically; Hobby = once a day). Use
# SECOND_BRAIN_CRON_SECRET for pg_cron + pg_net, GitHub Actions or any other scheduler. The legacy app_config.cron_token keeps working too.
# Generate: openssl rand -hex 32
# SECOND_BRAIN_CRON_SECRET=
# SECOND_BRAIN_CRON_SECRET_PREVIOUS=
# CRON_SECRET=

# ---------------------------------------------------------------------------
# n8n – schedules, Telegram bot relay, backups (optional, recommended)
# ---------------------------------------------------------------------------
# SECRET – header `x-api-key` for every /api/public/n8n/* endpoint (bot, capture, digest,
# reminders, maintenance, backup, calendar/sync, events). Fails closed when unset.
# Put the same value in the n8n Header Auth credential "Second Brain x-api-key".
# The n8n templates read their own SB_-prefixed env (SB_APP_URL, SB_TELEGRAM_BOT_TOKEN, …;
# see integrations/n8n/README.md) so they can share an n8n instance with other apps.
# Generate: openssl rand -hex 32
# N8N_API_KEY=
# Previous key, still accepted while rotating
# N8N_API_KEY_PREVIOUS=

# ---------------------------------------------------------------------------
# Sentry – error monitoring + web vitals (optional; off when the DSN is empty)
# ---------------------------------------------------------------------------
# Browser DSN (public, inlined at build time). Without it no SDK is loaded and nothing is sent.
# VITE_SENTRY_DSN=
# Optional browser overrides: environment (default: Vite mode), release, tracing sample rate (0)
# VITE_SENTRY_ENVIRONMENT=
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0
# Server DSN (runtime; may be the same project). Reports SSR, middleware and n8n 500 errors.
# SENTRY_DSN=
# Environment name (default: VERCEL_ENV or "production")
# SENTRY_ENVIRONMENT=production
# Performance tracing sample rate 0..1 (default 0 = errors only)
# SENTRY_TRACES_SAMPLE_RATE=0
# Release (default: VERCEL_GIT_COMMIT_SHA)
# SENTRY_RELEASE=
# Source-map upload runs in GitHub Actions (deploy.yml) only when the repository secrets
# SENTRY_AUTH_TOKEN, SENTRY_ORG and SENTRY_PROJECT exist. Not needed at runtime.

# ---------------------------------------------------------------------------
# Tooling – database migrations (local / CI only, not needed at runtime)
# ---------------------------------------------------------------------------
# SECRET – Postgres connection string used by drizzle-kit (bunx drizzle-kit migrate).
# Supabase: Project Settings → Database → Connection string (session pooler works on IPv4).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Telegram (optional)
# ---------------------------------------------------------------------------
# Two modes (a bot has exactly one webhook, pick one):
#   app mode – setWebhook → https://<app>/api/public/telegram/webhook (/start, /link, text → Inbox)
#   n8n mode – workflow 01 owns the webhook and relays updates to /api/public/n8n/bot
# SECRET – BotFather token (123456:ABC…). The app calls https://api.telegram.org/bot<token>/…
# directly for replies, reminders, automations and unblock notifications.
TELEGRAM_BOT_TOKEN=
# Bot username without "@" (optional). Enables the one-tap t.me/<bot>?start=<code> link in Settings.
# TELEGRAM_BOT_USERNAME=
# SECRET – required in app mode. The webhook fails closed: it rejects every request
# when this is unset or the X-Telegram-Bot-Api-Secret-Token header does not match.
# Register the same value via setWebhook(secret_token=...). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar – per-user OAuth 2.0 (optional)
# ---------------------------------------------------------------------------
# Google Cloud console → APIs & Services → enable "Google Calendar API" → Credentials →
# OAuth client ID (type "Web application"). Authorized redirect URI:
#   https://<your-app>/oauth/google-calendar/return   (and http://localhost:3000/... for dev)
# Scope requested: https://www.googleapis.com/auth/calendar.events (offline access + PKCE).
GOOGLE_CLIENT_ID=
# SECRET – OAuth client secret (server only)
GOOGLE_CLIENT_SECRET=
# Redirect URI sent to Google. Default: $APP_URL/oauth/google-calendar/return, else the request
# origin. Must match the URI registered on the OAuth client exactly.
# GOOGLE_OAUTH_REDIRECT_URL=
# SECRET – base64-encoded 32-byte AES-GCM key that encrypts stored OAuth tokens.
# Generate: openssl rand -base64 32   (rotating it disconnects every user once)
TOKEN_ENCRYPTION_KEY=
