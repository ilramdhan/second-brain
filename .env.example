# Second Brain – environment variables
# Copy to .env (git-ignored) and fill in the values:  cp .env.example .env
# Set the same variables in your hosting provider (e.g. Vercel → Settings → Environment Variables).
# NEVER commit real values. VITE_* variables are inlined into the client bundle at
# build time and are therefore PUBLIC; everything else must stay server-side.

# ---------------------------------------------------------------------------
# Supabase – browser client (required, public, build-time)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon / publishable key (safe to expose; access is enforced by RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Supabase – server (required)
# ---------------------------------------------------------------------------
# Used for SSR, the auth middleware and the admin client
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key used by requireSupabaseAuth to build a per-user (RLS) client
SUPABASE_PUBLISHABLE_KEY=
# SECRET – bypasses RLS. Used only server-side (Telegram webhook, reminders,
# unblock notifications, encrypted connection store). Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Nitro deploy preset for `vite build`. Default: vercel (writes .vercel/output).
# Other examples: node-server (self-hosting, run .output/server/index.mjs), cloudflare-module.
# NITRO_PRESET=vercel
# Security headers are added to SSR/API responses in production; set to "off" only when the
# host already sends its own policy.
# SECURITY_HEADERS=on

# ---------------------------------------------------------------------------
# AI – capture, brain dump, summaries, OCR, voice (optional)
# ---------------------------------------------------------------------------
# Without AI_API_KEY the AI buttons show "AI belum dikonfigurasi"; everything else works.
# openai (default, OpenAI Responses API) | openai-compatible (any Chat Completions API)
AI_PROVIDER=openai
# SECRET – API key of the provider
AI_API_KEY=
# Base URL for openai-compatible providers (required there). Free-tier friendly examples:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1   (also offers whisper-large-v3 for voice)
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
# AI_BASE_URL=
# Text model (default gpt-4o-mini). E.g. llama-3.3-70b-versatile (Groq), gemini-2.0-flash
# AI_MODEL=gpt-4o-mini
# Model for image input / OCR; defaults to AI_MODEL (must support vision)
# AI_VISION_MODEL=
# Speech-to-text model for voice capture (OpenAI-style /audio/transcriptions). Default whisper-1;
# e.g. gpt-4o-mini-transcribe (OpenAI) or whisper-large-v3 (Groq)
# AI_TRANSCRIBE_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Cron – deadline reminders (optional)
# ---------------------------------------------------------------------------
# /api/public/hooks/reminders (GET or POST) requires `Authorization: Bearer <secret>`.
# Accepted (constant-time compare): SECOND_BRAIN_CRON_SECRET, SECOND_BRAIN_CRON_SECRET_PREVIOUS
# (keep the old value here while rotating) and CRON_SECRET (Vercel Cron sends
# `Authorization: Bearer $CRON_SECRET` automatically). Use SECOND_BRAIN_CRON_SECRET for n8n,
# GitHub Actions or any other scheduler. The legacy app_config.cron_token keeps working too.
# Generate: openssl rand -hex 32
# SECOND_BRAIN_CRON_SECRET=
# SECOND_BRAIN_CRON_SECRET_PREVIOUS=
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Tooling – database migrations (local / CI only, not needed at runtime)
# ---------------------------------------------------------------------------
# SECRET – Postgres connection string used by drizzle-kit (bunx drizzle-kit migrate).
# Supabase: Project Settings → Database → Connection string (session pooler works on IPv4).
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Telegram (optional)
# ---------------------------------------------------------------------------
# TODO(part 2): Telegram still goes through the Lovable connector gateway and needs the legacy
# key below; it will move to the Telegram Bot API directly.
# LOVABLE_API_KEY=
# SECRET – connection key of the Lovable Telegram connector (X-Connection-Api-Key),
# not a raw BotFather token
TELEGRAM_API_KEY=
# SECRET – required for the bot. The webhook fails closed: it rejects every request
# when this is unset or the X-Telegram-Bot-Api-Secret-Token header does not match.
# Register the same value via setWebhook(secret_token=...). Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Google Calendar – per-user App User Connector (optional)
# ---------------------------------------------------------------------------
# TODO(part 2): still uses the Lovable App User Connector (plus LOVABLE_API_KEY above); it will
# move to Google OAuth directly.
# SECRET – client API key of the Lovable Google Calendar App User Connector
GOOGLE_CALENDAR_APP_USER_CONNECTOR_CLIENT_API_KEY=
# SECRET – base64-encoded 32-byte AES-GCM key for encrypting connection handles.
# Generate: openssl rand -base64 32   (rotating it invalidates stored connections)
APP_USER_CONNECTION_KEY_SECRET=
