    {
      "parameters": {
        "jsCode": "// Pecah respons { messages: [...] } menjadi satu item per pesan Telegram.\n// Server hanya mengembalikan chat yang sudah ditautkan (profiles.telegram_chat_id); n8n tetap memfilter allow-list.\nconst allowed = String($env.TELEGRAM_ALLOWED_CHAT_IDS || '').split(',').map(s => s.trim()).filter(Boolean);\nconst out = [];\nfor (const item of $input.all()) {\n  for (const m of item.json.messages || []) {\n    const chat = String(m.chat_id || '');\n    if (!chat || (allowed.length && !allowed.includes(chat))) continue;\n    out.push({ json: { chat_id: chat, text: String(m.text || '').slice(0, 4000), parse_mode: m.parse_mode || null, reply_markup: m.reply_markup || null } });\n  }\n}\nreturn out;"
      },
      "id": "c2dcac67-9eac-41e8-bb33-4110b1be4008",
      "name": "Pecah per chat",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ chat_id: $json.chat_id, text: $json.text, disable_web_page_preview: true }, $json.parse_mode ? { parse_mode: $json.parse_mode } : {}, $json.reply_markup ? { reply_markup: $json.reply_markup } : {})) }}"
      },
