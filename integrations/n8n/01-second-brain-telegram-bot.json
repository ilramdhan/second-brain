    {
      "parameters": {
        "jsCode": "// Susun payload transkripsi voice/audio untuk Second Brain.\nconst src = $('Normalize & Guard').item.json;\nconst text = String($json.text || '').trim();\nreturn {\n  json: {\n    payload: {\n      ...src.meta,\n      kind: 'voice',\n      source: 'voice',\n      text: src.caption || null,\n      transcript: text.slice(0, 20000),\n      duration: src.duration ?? null,\n      mime_type: src.mime_type,\n    },\n  },\n};",
        "mode": "runOnceForEachItem"
      },
