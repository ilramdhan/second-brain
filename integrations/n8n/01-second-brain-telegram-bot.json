    {
      "parameters": {
        "jsCode": "// Bangun request OpenAI Responses API (vision) dari file Telegram yang sudah diunduh.\nconst src = $('Normalize & Guard').item.json;\nconst buf = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\nif (buf.length > 15_000_000) throw new Error('File terlalu besar untuk OCR');\nconst b64 = buf.toString('base64');\nconst prompt = 'Ekstrak SEMUA teks dari file ini (foto papan tulis, tulisan tangan, dokumen, screenshot, struk). ' +\n  'Tulis dalam bahasa aslinya, rapikan menjadi markdown terstruktur (judul, daftar, tabel bila ada). ' +\n  'Tandai bagian yang tidak terbaca dengan [?]. Jangan menambah informasi yang tidak ada. Balas hanya dengan hasil ekstraksi.';\nconst filePart = src.mime_type === 'application/pdf'\n  ? { type: 'input_file', filename: src.file_name || 'document.pdf', file_data: `data:application/pdf;base64,${b64}` }\n  : { type: 'input_image', image_url: `data:${src.mime_type};base64,${b64}`, detail: 'high' };\nreturn {\n  json: {\n    openai_body: {\n      model: $env.OPENAI_VISION_MODEL || 'gpt-4.1-mini',\n      max_output_tokens: 4000,\n      input: [{ role: 'user', content: [{ type: 'input_text', text: prompt }, filePart] }],\n    },\n  },\n};",
        "mode": "runOnceForEachItem"
      },
