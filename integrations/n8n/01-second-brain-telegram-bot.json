    {
      "parameters": {
        "jsCode": "// Ambil teks hasil OCR dari respons OpenAI lalu susun payload untuk Second Brain.\nconst src = $('Normalize & Guard').item.json;\nconst r = $json;\nlet text = r.output_text;\nif (!text && Array.isArray(r.output)) {\n  text = r.output.flatMap(o => o.content || []).filter(c => c.type === 'output_text').map(c => c.text).join('\\n');\n}\ntext = String(text || '').trim();\nreturn {\n  json: {\n    payload: {\n      ...src.meta,\n      kind: 'ocr',\n      source: 'ocr',\n      text: src.caption || null,          // caption bisa berisi perintah: /task, /note, /inbox\n      ocr_text: text.slice(0, 20000),\n      file_name: src.file_name,\n      mime_type: src.mime_type,\n      ocr_model: r.model ?? null,\n    },\n  },\n};",
        "mode": "runOnceForEachItem"
      },
      "id": "674921f0-7f96-4be2-bc42-62c4c866cf24",
      "name": "OCR → payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// Telegram voice = .oga; OpenAI menerima .ogg (format sama).\nconst item = $input.item;\nconst b = item.binary.data;\nb.fileName = String(b.fileName || 'voice.ogg').replace(/\\.oga$/i, '.ogg');\nif (!/\\.[a-z0-9]+$/i.test(b.fileName)) b.fileName += '.ogg';\nreturn item;",
        "mode": "runOnceForEachItem"
      },
      "id": "d711814d-e62c-4cc3-8dca-60c58d47e743",
