      },
      "id": "816dac13-b896-4657-b529-9e95b7fec12e",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "webhookId": "dfc3affe-356b-4231-89a1-6d50715a0021",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram Second Brain Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalisasi update Telegram + allow-list (fail-closed: daftar kosong = tolak semua).\nconst allowed = String($env.TELEGRAM_ALLOWED_CHAT_IDS || '').split(',').map(s => s.trim()).filter(Boolean);\nconst MAX_FILE_BYTES = 19_000_000; // batas getFile Bot API = 20 MB\nconst out = [];\n\nfor (const item of $input.all()) {\n  const u = item.json;\n  const cb = u.callback_query;\n  const msg = cb ? cb.message : (u.message || u.edited_message);\n  const chatId = String(msg?.chat?.id ?? cb?.from?.id ?? '');\n  const from = cb?.from ?? msg?.from ?? {};\n  const base = {\n    update_id: u.update_id,\n    chat_id: chatId,\n    message_id: msg?.message_id ?? null,\n    callback_id: cb?.id ?? null,\n  };\n  const meta = { update_id: u.update_id, chat_id: chatId, message_id: msg?.message_id ?? null, username: from.username ?? null, first_name: from.first_name ?? null };\n\n  if (!chatId || !allowed.includes(chatId)) { out.push({ json: { ...base, type: 'blocked' } }); continue; }\n\n  if (cb) {\n    out.push({ json: { ...base, type: 'callback', payload: { ...meta, kind: 'callback', callback_data: String(cb.data || '').slice(0, 64) } } });\n    continue;\n  }\n\n  // Media: foto, dokumen (gambar/PDF), voice note, audio\n  let media = null;\n  if (Array.isArray(msg?.photo) && msg.photo.length) {\n    const p = msg.photo[msg.photo.length - 1]; // resolusi terbesar\n    media = { kind: 'vision', file_id: p.file_id, file_size: p.file_size ?? 0, mime_type: 'image/jpeg', file_name: 'photo.jpg' };\n  } else if (msg?.document) {\n    const d = msg.document; const mt = d.mime_type || '';\n    if (/^image\\/(jpeg|png|webp|gif)$/.test(mt) || mt === 'application/pdf') {\n      media = { kind: 'vision', file_id: d.file_id, file_size: d.file_size ?? 0, mime_type: mt, file_name: d.file_name || 'document' };\n    } else if (/^audio\\//.test(mt)) {\n      media = { kind: 'audio', file_id: d.file_id, file_size: d.file_size ?? 0, mime_type: mt, file_name: d.file_name || 'audio' };\n    } else {\n      out.push({ json: { ...base, type: 'reply', reply: '📎 Jenis file ini belum didukung. Kirim foto, gambar, PDF, atau voice note.' } });\n      continue;\n    }\n  } else if (msg?.voice || msg?.audio) {\n    const a = msg.voice || msg.audio;\n    media = { kind: 'audio', file_id: a.file_id, file_size: a.file_size ?? 0, mime_type: a.mime_type || 'audio/ogg', file_name: a.file_name || 'voice.ogg', duration: a.duration ?? null };\n  }\n\n  if (media) {\n    if (media.file_size > MAX_FILE_BYTES) {\n      out.push({ json: { ...base, type: 'reply', reply: '⚠️ File terlalu besar (maks ±19 MB untuk bot Telegram).' } });\n      continue;\n    }\n    out.push({ json: { ...base, type: 'media', ...media, caption: (msg.caption ?? '').slice(0, 1000), meta } });\n    continue;\n  }\n\n  const text = msg?.text ?? null;\n  if (text) {\n    out.push({ json: { ...base, type: 'text', payload: { ...meta, kind: 'text', source: 'telegram', text: text.slice(0, 4000) } } });\n    continue;\n  }\n\n  out.push({ json: { ...base, type: 'reply', reply: '🙏 Bot ini menerima teks, foto, dokumen (gambar/PDF), dan voice note. Ketik /help untuk bantuan.' } });\n}\nreturn out;"
      },
